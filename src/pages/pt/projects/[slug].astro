---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import Footer from '../../../components/Footer.astro';
import { allProjects, getContent } from '../../../data';

export function getStaticPaths() {
  return allProjects('pt').map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const c = getContent('pt');
const project = allProjects('pt').find((p) => p.slug === slug)!;
---
<Base lang="pt" title={`${project.title} | ${c.profile.name}`} description={project.summary} path={`projects/${slug}/`}>
  <Header lang="pt" sub switchHref={`/projects/${slug}/`} />
  <main id="main">
    <CaseStudy lang="pt" slug={slug!} />
  </main>
  <Footer lang="pt" sub />
</Base>
