---
import type { Lang } from '../data/types';
import { getContent } from '../data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui, profile } = getContent(lang);
const items = [
  ['about', ui.nav.about],
  ['process', ui.nav.process],
  ['experience', ui.nav.experience],
  ['projects', ui.nav.projects],
  ['skills', ui.nav.skills],
  ['contact', ui.nav.contact],
] as const;
---
<a class="skip" href="#main">{ui.skipToContent}</a>
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={profile.name}>&lt;TR /&gt;</a>
    <div class="tools">
      <nav class="nav" id="site-nav" aria-label="Primary">
        <ul>
          {items.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
        <a class="btn secondary" href={profile.resumeFile} download>{ui.nav.resume}</a>
      </nav>
      <a class="icon-btn" href={ui.langSwitch.targetHref} hreflang={lang === 'en' ? 'pt-BR' : 'en'} lang={lang === 'en' ? 'pt-BR' : 'en'} aria-label={`${ui.langSwitch.label}: ${ui.langSwitch.targetName}`}>{lang === 'en' ? 'PT' : 'EN'}</a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={ui.themeToggle} aria-pressed="false">◐</button>
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-controls="site-nav" aria-expanded="false">{ui.menu}</button>
    </div>
  </div>
</header>
