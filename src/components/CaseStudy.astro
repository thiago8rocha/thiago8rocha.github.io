---
import type { Lang } from '../data/types';
import { getContent, allProjects, basePath } from '../data';
import Icon from './Icon.astro';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const c = getContent(lang);
const { ui, featured } = c;
const t = ui.caseStudy;
const list = allProjects(lang);
const index = list.findIndex((p) => p.slug === slug);
const p = list[index];
const next = list[(index + 1) % list.length];
const base = basePath(lang);
const detail = p.caseStudy ?? {};
const isFeatured = p.slug === featured.slug;
---
<div class="case" id="top">
  <div class="container">
    <a class="back" href={`${base}#projects`}><Icon name="arrow" />{t.back}</a>

    <header class="case-hero">
      <div class="badges"><span class:list={['badge', { warn: p.group === 'personal' }]}>{p.badge}</span><span class="domain">{p.domain}</span></div>
      <h1>{p.title}</h1>
      <p class="lead">{p.summary}</p>
      <dl class="case-meta">
        <div><dt>{t.client}</dt><dd>{p.client}</dd></div>
        <div><dt>{t.domain}</dt><dd>{p.domain}</dd></div>
      </dl>
      {p.links && (
        <div class="actions">
          {p.links.map((l) => <a class="btn" href={l.href} rel="noopener"><Icon name="github" />{l.label}</a>)}
        </div>
      )}
    </header>

    <div class="case-body">
      <section aria-labelledby="cs-overview">
        <h2 id="cs-overview">{t.overview}</h2>
        {detail.overview ? detail.overview.map((x) => <p>{x}</p>) : <p class="placeholder">{t.placeholder}</p>}
        {isFeatured && (
          <div class="metrics">
            {featured.metrics.map((m) => <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}
          </div>
        )}
      </section>

      <section aria-labelledby="cs-role">
        <h2 id="cs-role">{t.role}</h2>
        <div class="rolebox">{p.role}</div>
      </section>

      <section aria-labelledby="cs-stack">
        <h2 id="cs-stack">{t.stack}</h2>
        <ul class="chips">{p.tools.map((x) => <li class="chip accent">{x}</li>)}</ul>
        <h3 class="sr-only">{t.testing}</h3>
        <ul class="chips" aria-label={t.testing}>{p.testTypes.map((x) => <li class="chip">{x}</li>)}</ul>
      </section>

      {isFeatured && (
        <section aria-labelledby="cs-arch">
          <h2 id="cs-arch">{t.architecture}</h2>
          <div class="arch">
            <ol>{featured.layers.map((l) => <li><strong>{l.name}</strong><span>{l.detail}</span></li>)}</ol>
            <p class="note">{featured.layersNote}</p>
          </div>
          <p class="note">{featured.confidentialityNote}</p>
        </section>
      )}

      <section aria-labelledby="cs-how">
        <h2 id="cs-how">{t.howItWorks}</h2>
        {detail.howItWorks ? <ol class="dash">{detail.howItWorks.map((x) => <li>{x}</li>)}</ol> : <p class="placeholder">{t.placeholder}</p>}
      </section>

      <section aria-labelledby="cs-challenges">
        <h2 id="cs-challenges">{t.challenges}</h2>
        {detail.challenges ? detail.challenges.map((ch) => (
          <article class="card case-card">
            <h3>{ch.title}</h3>
            <dl>
              <div><dt>{t.challenge}</dt><dd>{ch.challenge}</dd></div>
              <div><dt>{t.approach}</dt><dd>{ch.approach}</dd></div>
              <div><dt>{t.outcome}</dt><dd>{ch.outcome}</dd></div>
            </dl>
          </article>
        )) : <p class="placeholder">{t.placeholder}</p>}
      </section>

      <section aria-labelledby="cs-achievements">
        <h2 id="cs-achievements">{t.achievements}</h2>
        {detail.achievements ? <ul class="dash">{detail.achievements.map((x) => <li>{x}</li>)}</ul> : <p class="placeholder">{t.placeholder}</p>}
      </section>
    </div>

    <nav class="case-next" aria-label={t.next}>
      <div>
        <p class="label">{t.next}</p>
        <strong>{next.title}</strong>
      </div>
      <a class="btn" href={`${base}projects/${next.slug}/`}>{ui.projects.viewCaseStudy}<span class="sr-only">: {next.title}</span><Icon name="arrow" /></a>
    </nav>
  </div>
</div>
